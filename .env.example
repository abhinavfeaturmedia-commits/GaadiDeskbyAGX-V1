# ==========================================
# GaadiDesk Environment Configuration
# ==========================================

# App Environment (development, staging, production)
NODE_ENV=development
APP_ENV=development

# Server / Port configuration (if applicable)
PORT=5173

# Google OAuth / APIs (if required for cloud deliverables)
# GOOGLE_APPLICATION_CREDENTIALS=credentials.json

# SMS / WhatsApp API Gateway (e.g., Gupshup / Twilio / Interakt)
WHATSAPP_API_KEY=
WHATSAPP_SENDER_NUMBER=

# Payment Gateway (e.g., Razorpay / Cashfree)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
